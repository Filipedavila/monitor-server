import { Injectable } from '@nestjs/common';
import { InjectRepository } from '@nestjs/typeorm';
import { Repository, SelectQueryBuilder } from 'typeorm';
import { User } from '../user.entity';
import { BaseTransactionalRepository } from '../../common/repositories/base-transactional.repository';
import { FilterMap, SortCriteria, SortingMap } from 'src/common/repositories/base.repository';
import { BaseFilterDto } from 'src/common/dto/base-filter.dto';

export class UserFilterDto extends BaseFilterDto {
  searchTerm?: string;
  type?: string;
  excludeAdmin?: boolean;
}

@Injectable()
export class UserRepository extends BaseTransactionalRepository<User, UserFilterDto, any> {
  constructor(@InjectRepository(User) private readonly ormRepo: Repository<User>) {
    super(ormRepo);
  }

  protected readonly filterMap: FilterMap<UserFilterDto, User> = {
    ids: (query, ids) => ids?.length && query.andWhere('u.UserId IN (:...ids)', { ids }),
    searchTerm: (query, term) => 
      query.andWhere('(u.Username LIKE :term OR u.Names LIKE :term OR u.Emails LIKE :term)', { term: `%${term}%` }),
    type: (query, type) => query.andWhere('u.Type = :type', { type }),
    excludeAdmin: (query) => query.andWhere('u.Type != "admin"'),
  };

  protected readonly sortMap: SortingMap<any, User> = {
    username: (query, order: SortCriteria) => query.addOrderBy('u.Username', order),
    registerDate: (query, order: SortCriteria) => query.addOrderBy('u.Register_Date', order),
    websitesCount: (query, order: SortCriteria) => query.addOrderBy('Websites', order),
  };


  async findWithWebsitesCount(filters: UserFilterDto, pagination: any): Promise<[any[], number]> {
    const query = this.ormRepo.createQueryBuilder('u')
      .leftJoin('Website', 'w', 'w.UserId = u.UserId')
      .select(['u.UserId', 'u.Username', 'u.Names', 'u.Emails', 'u.Type', 'u.Register_Date', 'u.Last_Login'])
      .addSelect('COUNT(DISTINCT w.WebsiteId)', 'Websites')
      .groupBy('u.UserId');

    this.applyPagination(query, pagination, filters, pagination);

    const users = await query.getRawMany();
    const total = await this.ormRepo.count();

    return [users, total];
  }


  async updateWebsiteVisibility(websiteIds: number[], showIn: string, showTo: string) {

    await this.orm.manager.query(`
      UPDATE Website as w, WebsitePage as wp, Page as p, Evaluation as e
      SET p.Show_In = ?, e.Show_To = ?
      WHERE w.WebsiteId IN (?) AND wp.WebsiteId = w.WebsiteId AND p.PageId = wp.PageId AND e.PageId = p.PageId
    `, [showIn, showTo, websiteIds]);
  }
}