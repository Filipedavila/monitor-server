model
  schema 1.1

type user

type role
  relations
    define member: [user]

type directory
  relations
    define admin: [role]

    define can_manage: member from admin 
    define can_view: member from admin

type tag
  relations
    define admin: [role]

    define can_manage: member from admin 
    define can_view: member from admin

type accessibility_statement
  relations
    define admin: [role]

    define can_manage: member from admin 
    define can_view: member from admin
  
type organization
  relations
    define admin: [role,user]
    define member: [user]    
    
    define can_manage: member from admin  or admin
    define can_edit: member from admin or member
    define can_view: member from admin or member

type website
  relations
    define parent: [organization]
    define owner: [user]
    define study_assignee: [user]
    
    define can_manage: owner or can_manage from parent
    define can_edit: owner or can_edit from parent
    define can_view: study_assignee or owner or can_view from parent

type page
  relations
    define parent: [website]
    define can_manage: can_manage from parent
    define can_edit: can_edit from parent
    define can_view: can_view from parent
   
type crawler_website
  relations
    define parent: [website]
    define owner: [user]
    
    define can_manage: owner or can_manage from parent
    define can_edit: owner or can_edit from parent
    define can_view: owner or can_view from parent

type crawler_page
  relations
    define parent: [crawler_website]
    
    define can_manage: can_manage from parent
    define can_edit: can_edit from parent
    define can_view: can_view from parent

type evaluation
  relations
    define parent: [website]
    define owner: [user, role]
    define can_manage: (owner or member from owner) and can_manage from parent
    define can_edit: (owner or member from owner) and can_edit from parent
    define can_view: (owner or member from owner) and can_view from parent

